{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PropertyInvestmentAnalyst;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "MarketData": {
    "AllowManualRefresh": false,
    "LicensedFeed": {
      "BaseUrl": "",
      "ApiKey": "",
      "ApiKeyHeader": "X-Api-Key",
      "TimeoutSeconds": 10,
      "MaxRetries": 2
    }
  },
  "InvestmentAnalyst": {
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "TimeoutSeconds": 20,
      "MaxOutputTokens": 1500
    }
  }
}
